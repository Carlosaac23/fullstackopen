@baseUrl = http://localhost:4000

# Get notes
GET {{baseUrl}}/api/notes

###
# Get note
GET {{baseUrl}}/api/notes/6a6a84750683e23cec4d5612

###
# Create note
POST {{baseUrl}}/api/notes
Content-Type: application/json
Authorization: Bearer {{$dotenv JWT_TOKEN}}

{
  "content": "I do like watching movies",
  "important": true
}

###
# Update note
PUT {{baseUrl}}/api/notes/6a71ff5207a86d9776e25018
Content-Type: application/json

{
  "content": "I do like watching soccer!"
}

###
# Delete note
DELETE {{baseUrl}}/api/notes/6a6bb2b764b2cb650da33fc5

###
# Unknown endpoint
GET {{baseUrl}}/note/info
